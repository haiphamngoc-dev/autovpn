{
  "app": {
    "windows": [
      {
        "title": "AutoVPN",
        "width": 800,
        "height": 600,
        "decorations": false,
        "devtools": true,
        "transparent": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "icon": ["icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["openvpn"],
        "files": {
          "/usr/local/bin/autovpn-helper": "../../../target/release/helper-daemon",
          "/lib/systemd/system/autovpn-helper.service": "../../../scripts/deb/autovpn-helper.service"
        },
        "postInstallScript": "../../../scripts/deb/postinst",
        "preRemoveScript": "../../../scripts/deb/prerm",
        "postRemoveScript": "../../../scripts/deb/postrm"
      },
      "rpm": {
        "depends": ["openvpn"],
        "files": {
          "/usr/local/bin/autovpn-helper": "../../../target/release/helper-daemon",
          "/lib/systemd/system/autovpn-helper.service": "../../../scripts/deb/autovpn-helper.service"
        },
        "postInstallScript": "../../../scripts/deb/postinst",
        "preRemoveScript": "../../../scripts/deb/prerm",
        "postRemoveScript": "../../../scripts/deb/postrm"
      }
    }
  }
}
