{
  "name": "autovpn-monorepo",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter autovpn-desktop tauri dev",
    "dev:desktop": "pnpm --filter autovpn-desktop tauri dev",
    "build": "pnpm --filter autovpn-desktop tauri build",
    "build:desktop": "pnpm --filter autovpn-desktop tauri build",
    "build:local": "pnpm --filter autovpn-desktop tauri build --no-signing",
    "build:deb": "bash scripts/build-deb.sh",
    "build:frontend": "pnpm --filter autovpn-desktop build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3"
  }
}
